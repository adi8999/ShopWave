# ── Core Security ─────────────────────────────────────────────────────────────
# REQUIRED: minimum 32 random characters. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_64_HEX_STRING

# ── Database ──────────────────────────────────────────────────────────────────
# Production PostgreSQL connection string (Neon, RDS, Render, etc.):
# E.g. Neon: postgresql://user:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require
# For local dev only:
# DATABASE_URL=sqlite:///./shopwave.db

# ── Seed Credentials (Admin & Demo User) ──────────────────────────────────────
# Used by `python -m app.seed` to create initial accounts.
# If ADMIN_PASSWORD or DEMO_USER_PASSWORD is not set, that account creation is skipped.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD

DEMO_USER_EMAIL=demo@yourdomain.com
DEMO_USER_PASSWORD=REPLACE_WITH_DEMO_PASSWORD

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash).
# Example: https://shopwave.vercel.app,http://localhost:5173
# Defaults to http://localhost:5173 if not set (local dev only).
ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173

# ── Stripe Payments ───────────────────────────────────────────────────────────
# Get keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# ── AI / Chatbot ──────────────────────────────────────────────────────────────
# Provide at least one. If none set, rule-based fallback is used.
GEMINI_API_KEY=REPLACE_ME
OPENROUTER_API_KEY=REPLACE_ME
OPENAI_API_KEY=REPLACE_ME

# ── Redis (Rate Limiting) ─────────────────────────────────────────────────────
# Local: redis://localhost:6379
# Production: redis://your-redis-host:6379 (Optional; falls back to in-memory)
REDIS_URL=redis://localhost:6379
