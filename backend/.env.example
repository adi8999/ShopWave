# ── Core Security ─────────────────────────────────────────────────────────────
# REQUIRED: minimum 32 random characters. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_64_HEX_STRING

# ── Database ──────────────────────────────────────────────────────────────────
# AWS RDS PostgreSQL connection string (use IAM auth or strong password):
DATABASE_URL=postgresql://shopwave_user:STRONG_PASSWORD@your-rds-host.us-east-1.rds.amazonaws.com:5432/shopwave
# For local dev only:
# DATABASE_URL=sqlite:///./shopwave.db

# ── Admin Seed Credentials ────────────────────────────────────────────────────
# Used by `python -m app.seed` to create the initial admin account.
# If ADMIN_PASSWORD is not set, no admin user will be created.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash).
# Example: https://shopwave.example.com,https://www.shopwave.example.com
# Defaults to http://localhost:5173 if not set (local dev only).
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── Stripe Payments ───────────────────────────────────────────────────────────
# Get keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# ── AI / Chatbot ──────────────────────────────────────────────────────────────
# Provide at least one. If none set, rule-based fallback is used.
GEMINI_API_KEY=REPLACE_ME
OPENROUTER_API_KEY=REPLACE_ME
OPENAI_API_KEY=REPLACE_ME

# ── Redis (Rate Limiting) ─────────────────────────────────────────────────────
# Local: redis://localhost:6379
# Production: redis://your-redis-host:6379
REDIS_URL=redis://localhost:6379
