# ── Core Security ─────────────────────────────────────────────────────────────
# REQUIRED: Minimum 16 characters, random & secret. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-change-me-min-16-chars

# ── Database ───────────────────────────────────────────────────────────────────
# Leave blank for local SQLite, or set your PostgreSQL connection string:
DATABASE_URL=postgresql://username:password@localhost:5432/shopwave

# ── Admin Seed Credentials ────────────────────────────────────────────────────
# Used by `python -m app.seed` to create the initial admin account.
# If not set, a random password is generated and printed at seed time.
ADMIN_EMAIL=admin@shopwave.com
ADMIN_PASSWORD=ChangeMe_Str0ng!

# ── Stripe Payments ───────────────────────────────────────────────────────────
# Get keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ── AI / Chatbot ──────────────────────────────────────────────────────────────
# Provide at least one of the following to enable AI chatbot responses.
# If none are set, the rule-based fallback (local DB search) is used.
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Optional: override default model names
# GEMINI_MODEL=gemini-2.5-flash
# OPENROUTER_MODEL=google/gemini-3.7-flash
# OPENAI_MODEL=gpt-4o-mini

# ── Redis (Rate Limiting) ──────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
