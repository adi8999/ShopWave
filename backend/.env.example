# ── Core Security ─────────────────────────────────────────────────────────────
# REQUIRED: minimum 32 random characters. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_64_HEX_STRING
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173

# ── Database ──────────────────────────────────────────────────────────────────
# Production PostgreSQL connection string (RDS, Neon, Render, etc.):
# DATABASE_URL=postgresql://user:password@your-db-host:5432/shopwave?sslmode=require
DATABASE_URL=sqlite:///./shopwave.db

# ── Seed Credentials (Admin & Demo User) ──────────────────────────────────────
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD

DEMO_USER_EMAIL=demo@yourdomain.com
DEMO_USER_PASSWORD=REPLACE_WITH_DEMO_PASSWORD

# ── CORS & Proxy Trust ────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://your-frontend.example.com,http://localhost:5173
TRUSTED_PROXIES=127.0.0.1,::1

# ── Email Delivery (SMTP or AWS SES) ──────────────────────────────────────────
# Supported: console (dev only) | smtp | ses
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@yourdomain.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=REPLACE_WITH_SMTP_USER
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_USE_TLS=true
# AWS_SES_REGION=us-east-1

# ── Stripe Payments ───────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# ── AI / Chatbot ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=REPLACE_ME
OPENROUTER_API_KEY=REPLACE_ME
OPENAI_API_KEY=REPLACE_ME

# ── Redis (Rate Limiting & WebSocket Tickets) ─────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Object Storage (S3 / Cloudflare R2) & Monitoring ──────────────────────────
# S3_BUCKET=your-product-images-bucket
# S3_ENDPOINT_URL=https://your-account.r2.cloudflarestorage.com
# S3_PUBLIC_URL=https://cdn.yourdomain.com
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
